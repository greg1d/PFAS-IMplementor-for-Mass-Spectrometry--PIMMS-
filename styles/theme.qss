QMainWindow {
    background: rgb(218, 215, 205); /* Light grey background */
    background-image: radial-gradient(circle, rgba(128, 128, 128, 0.5) 1px, rgba(0, 0, 0, 0) 1px);
    color: #ffffff;
    font-family: Arial;
    font-size: 20pt;
}

QPushButton {
    background-color: #4caf50;
    color: white;
    border-radius: 10px;
    padding: 10px;
}

QPushButton:hover {
    background-color: #45a049;
}

QLabel {
    color: #ffffff;
}