# ----------------------------------------------------------------
# PyInstaller - Build artifacts for the PIMMS application
# ----------------------------------------------------------------
# These folders contain the final executable and intermediate files.
# They are large and should be generated, not stored in Git.
/build/
/dist/
/Output/
/figures/
# The build specification file generated by PyInstaller.
*.spec


# ----------------------------------------------------------------
# Python - Virtual Environments
# ----------------------------------------------------------------
# Never commit virtual environment folders.
/pimms_conda_env/
/pimms_env/
/venv/
/.venv/
/env/


# ----------------------------------------------------------------
# Python - Cache and Bytecode
# ----------------------------------------------------------------
# These files are generated by the Python interpreter to speed up execution.
__pycache__/
*.pyc
*.pyo
*.pyd


# ----------------------------------------------------------------
# Editor & IDE-specific files
# ----------------------------------------------------------------
# These folders store user-specific settings for your code editor.
/.vscode/
/.idea/


# ----------------------------------------------------------------
# Operating System files
# ----------------------------------------------------------------
# These are metadata files created by macOS and Windows.
.DS_Store
Thumbs.db